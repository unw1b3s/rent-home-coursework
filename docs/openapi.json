            "minimum": 5.0,
            "title": "Area"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "minLength": 7,
            "title": "Phone"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "rented"
            ],
            "title": "Status",
            "default": "available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "type_id",
          "city",
          "address",
          "price",
          "rooms",
          "area",
          "phone"
        ],
        "title": "ListingInput"
      },
